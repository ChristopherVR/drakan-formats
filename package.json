{
    "name": "@drakan/formats",
    "version": "0.1.0",
    "description": "Readers, writers and converters for the Drakan file formats: SRSC containers, levels, classes, terrain, models, textures, sounds, sequences, saves. Converts Drakan: Order of the Flame (PC) data to Drakan: The Ancients' Gates (PS2).",
    "license": "GPL-3.0-only",
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "src"
    ],
    "scripts": {
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "fflate": "0.8.3"
    },
    "devDependencies": {
        "@types/node": "24.19.0",
        "prettier": "3.9.9",
        "typescript": "7.0.2",
        "vitest": "3.2.7"
    },
    "engines": {
        "node": ">=20"
    }
}
